@model IEnumerable<BirthdayReminder.Models.Birthday>
@{
    ViewData["Title"] = "Birthdays List";
}

<div class="container">
    <h2>@ViewData["Title"]</h2>
    <p>
        <a asp-action="Create" class="btn btn-primary">Create New Birthday</a> <!-- Primær knap til at oprette nye fødselsdage -->
    </p>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Name) <!-- Kolonneoverskrift for navn -->
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Date) <!-- Kolonneoverskrift for dato -->
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Relationship) <!-- Kolonneoverskrift for relation -->
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Name) <!-- Viser navn -->
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Date) <!-- Viser dato -->
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Relationship) <!-- Viser relation -->
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a> <!-- Knap til redigering -->
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a> <!-- Knap til visning af detaljer -->
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a> <!-- Knap til sletning -->
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
